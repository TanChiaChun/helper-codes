{
  "files.associations": {
    "*.bats": "shellscript"
  },
  "files.eol": "\n",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "--config-file=./git-hooks/config/pytest.toml",
    "--rootdir=."
  ],
  "black-formatter.args": ["--config", "./git-hooks/config/pyproject.toml"],
  "prettier.configPath": "./git-hooks/config/.prettierrc.json"
}
